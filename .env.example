# Copy to .env and change every secret before deploying!

# PostgreSQL password (also used by all services)
DB_PASSWORD=change-me-strong-db-password

# JWT signing secret shared by all services (32+ random characters)
JWT_SECRET=change-me-long-random-string-at-least-32-chars

# Set false for single-shop desktop mode (everything runs as 'local-dev')
AUTH_ENABLED=true

# Public URL of the gateway (used in the customer share link)
APP_URL=http://localhost:3000

# Admin token for sync push/pull and license issue/list/revoke
SYNC_API_TOKEN=

# Invalidates all previously shared customer links when rotated
PUBLIC_REQUEST_SALT=

# Desktop-app licensing (base64 Ed25519 seed + public key)
LICENSE_PRIVATE_SEED=
LICENSE_PUBLIC_KEY=

# Live metal price provider: gold-api (free, default) | goldapi.io | metals-api
METAL_PRICE_PROVIDER=gold-api
METAL_PRICE_API_KEY=

# Secret for GET /api/cron/capture-gold-rate
CRON_SECRET=

# NPR conversion for the shared rate feed
FX_NPR_PER_USD=133
FX_NPR_PER_CAD=98

# Host port for the gateway
WEB_PORT=3000
